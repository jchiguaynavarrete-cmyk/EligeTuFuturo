# Copia este archivo como .env y ajusta los valores.
# El .env real NO se versiona: está en .gitignore.

PORT=3000

# --- Transbank ---------------------------------------------------------
# Solo "integration" está habilitado. El código rechaza cualquier otro valor
# a propósito: este proyecto no debe procesar pagos reales.
TBK_ENVIRONMENT=integration

# Credenciales públicas de integración de Transbank para Webpay Plus.
# No son secretas (Transbank las publica), pero se dejan aquí para que el
# día de mañana se cambien sin tocar el código.
TBK_COMMERCE_CODE=597055555532
TBK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C

# A dónde devuelve Webpay después del pago. Debe apuntar a ESTE backend.
TBK_RETURN_URL=http://localhost:3000/api/pagos/retorno

# --- Aplicación --------------------------------------------------------
# A dónde se envía a la persona después de confirmar el pago.
FRONTEND_URL=http://localhost:8101

# Orígenes autorizados para llamar a este backend, separados por coma.
CORS_ORIGINS=http://localhost:8101,http://localhost:4200,https://elige-tu-futuro-21166.web.app

# --- Firebase ----------------------------------------------------------
# Ruta al JSON de la cuenta de servicio. NUNCA subir ese archivo a git.
FIREBASE_CREDENTIALS=../scrap/serviceAccountKey.json
