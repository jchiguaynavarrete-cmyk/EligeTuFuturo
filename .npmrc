# Registro público de npm para este proyecto.
#
# EligeTuFuturo es un proyecto independiente y no usa el feed de paquetes
# de INACAP, que estaba configurado a nivel de usuario de Windows y se
# heredaba en todos los proyectos del equipo.
#
# Este archivo solo afecta a esta carpeta: el resto de los proyectos
# conserva su configuración.
registry=https://registry.npmjs.org/
