rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isVerified() {
      return isAuth() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }

    // =====================================================
    // 📚 CARRERAS
    // =====================================================
    match /carreras/{docId} {
      allow read: if true;

      allow update: if isAdmin();

      allow create, delete: if false;
    }

    // =====================================================
    // ⭐ FAVORITOS (por usuario)
    // =====================================================
    match /favoritos/{docId} {
      // Cada quien lee solo los suyos. El `resource == null` cubre la
      // consulta que hace la app antes de crear un favorito: sin eso,
      // Firestore deniega la lectura del documento que todavía no existe
      // y deja de poder agregarse.
      allow get: if isVerified()
                 && (resource == null || request.auth.uid == resource.data.uid);

      allow list: if isVerified()
                  && request.auth.uid == resource.data.uid;

      allow create: if isVerified()
                    && request.auth.uid == request.resource.data.uid;

      allow delete: if isVerified()
                    && request.auth.uid == resource.data.uid;

      allow update: if false;
    }

    // =====================================================
    // 🔔 NOTIFICACIONES (por usuario)
    // =====================================================
    match /notificaciones/{docId} {
      allow create: if isVerified()
                    && request.auth.uid == request.resource.data.uid;

      allow read: if isVerified()
                  && request.auth.uid == resource.data.uid;

      allow update, delete: if false;
    }

    // =====================================================
    // 👤 USUARIOS (perfil propio) - SOLO verificados
    // =====================================================
    match /usuarios/{uid} {
      allow read: if isVerified() && (request.auth.uid == uid || isAdmin());
      allow create: if isVerified() && request.auth.uid == uid;
      allow update: if isVerified() && request.auth.uid == uid;
      allow delete: if false;
    }

    // =====================================================
    // 🪪 RUT INDEX (anti-duplicados)
    // - Solo GET (no list) para evitar enumeración
    // - Solo verificados pueden crear su propio índice
    // =====================================================
    match /rut_index/{rut} {
      allow get: if isVerified();
      allow list: if false;

      allow create: if isVerified()
                    && request.auth.uid == request.resource.data.uid
                    && !exists(/databases/$(database)/documents/rut_index/$(rut));

      allow update, delete: if false;
    }

    // =====================================================
    // 💼 PLANES (catálogo institucional)
    // - Cualquiera con sesión puede verlos.
    // - Solo un admin crea o cambia precios y textos.
    // =====================================================
    // Lectura pública: la landing institucional los muestra sin pedir
    // sesión, y los precios de un plan comercial son información pública.
    match /planes/{planId} {
      allow read: if true;

      allow create, update: if isAdmin();

      allow delete: if false;
    }

    // =====================================================
    // 📨 CONTACTOS (formulario público de la landing)
    // - Los escribe solo el backend con el Admin SDK, que valida los
    //   datos y frena los envíos repetidos. Dejar escritura anónima
    //   aquí permitiría llenar la base de basura.
    // - Solo un admin puede leerlos.
    // =====================================================
    match /contactos/{contactoId} {
      allow read: if isAdmin();

      allow create, update, delete: if false;
    }

    // =====================================================
    // 📋 SOLICITUDES DE PLAN
    // - La institución ve y crea las suyas; el admin ve todas.
    // - Al crear se exigen valores neutros: nadie puede llegar
    //   con su solicitud ya aprobada ni ponerse un monto.
    // - El estado, el monto y el estado de pago los cambia solo
    //   el admin (o el backend, que usa el Admin SDK y se salta
    //   estas reglas).
    // =====================================================
    match /solicitudes/{solicitudId} {

      allow get: if isAdmin()
                  || (isVerified() && resource.data.uidSolicitante == request.auth.uid);

      // Firestore evalúa esto contra cada documento que devolvería la
      // consulta y la rechaza entera si alguno falla. Por eso una consulta
      // filtrada por el propio uid pasa, y una sin filtro no.
      allow list: if isAdmin()
                   || (isVerified() && resource.data.uidSolicitante == request.auth.uid);

      allow create: if isVerified()
                     && request.resource.data.uidSolicitante == request.auth.uid
                     && request.resource.data.estado == 'pendiente'
                     && request.resource.data.monto == null
                     && request.resource.data.pagoId == null
                     && request.resource.data.adminUid == null
                     && request.resource.data.estadoPago in ['pendiente', 'no_aplica']
                     && request.resource.data.cantidadEstudiantes is int
                     && request.resource.data.cantidadEstudiantes > 0
                     && request.resource.data.cantidadEstudiantes <= 100000
                     && request.resource.data.nombreInstitucion is string
                     && request.resource.data.nombreInstitucion.size() >= 3
                     && request.resource.data.nombreInstitucion.size() <= 80
                     && request.resource.data.rbd is string
                     && request.resource.data.correo is string;

      allow update: if isAdmin();

      allow delete: if false;
    }

    // =====================================================
    // 💳 PAGOS (Webpay)
    // - Los escribe únicamente el backend con el Admin SDK.
    // - Desde la app solo se pueden leer los propios.
    // =====================================================
    match /pagos/{pagoId} {
      allow get: if isAdmin()
                  || (isVerified() && resource.data.uidSolicitante == request.auth.uid);

      allow list: if isAdmin();

      allow create, update, delete: if false;
    }

    // =====================================================
    // 🏛️ INSTITUCIONES (plan vigente)
    // - La institución lee el suyo; el admin los lee todos.
    // - El plan y sus fechas los escribe el backend al confirmar
    //   el pago, para que no dependa del navegador.
    // =====================================================
    match /instituciones/{uid} {
      allow get: if isAdmin() || (isVerified() && request.auth.uid == uid);
      allow list: if isAdmin();

      allow create, update, delete: if false;
    }

    // =====================================================
    // 🚫 TODO LO DEMÁS BLOQUEADO
    // =====================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
